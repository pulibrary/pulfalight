<div class="overview", data-component-id="<%= document.refs.first %>">
  <% breadcrumbs = parents_to_links(document) %>
  <% unless breadcrumbs.nil? %>
    <nav class='breadcrumb-links media' aria-label="Breadcrumb">
      <span><%= parents_to_links(document) %></span>
    </nav>
  <% end %>
  <div class="lux document-title">
    <h2><%= document.normalized_title %></h2>
    <div class="document-attributes">
      <% if document.extent.present? %>
        <div class="document-extent">
          <span><%= document.extent %></span>
        </div>
      <% end %>
      <%= OnlineContentBadge.new(document).render %>
      <%= render partial: "restricted_badge", locals: { document: document, with_link: false } %>
      <% if document.is_portion? %>
        <div class="document-extent-digitized portion">
          <%= blacklight_icon :"icon-partial" %> Partially Digitized
        </div>
      <% end %>
    </div>
  </div>
  <%= render "shared/viewer" %>
  <%= render(partial: 'show_upper_metadata_default') %>
  <%= render(partial: "show_child_table") %>
</div>
